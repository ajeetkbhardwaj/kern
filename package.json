{
  "name": "kern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kern — a minimal, from-first-principles terminal coding agent kernel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "kern": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
